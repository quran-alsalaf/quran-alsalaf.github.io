<?xml version="1.0" encoding="utf-8"?>
<!--
  ويدجت «ختمتي اليوم» (widgets/KhatmaWidget.java، الجلسة ٣ ج ١). النصوص هنا مثال يظهر في معاينة قائمة الويدجتات،
  ويستبدلها KhatmaWidget بحال اليوم وألوان التطبيق.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#F5EDDC" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/widget_title"
            style="@style/WidgetText"
            android:layout_marginBottom="6dp"
            android:text="@string/widget_khatma_label"
            android:textColor="#8A6110"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- ختمة الورد -->
        <LinearLayout
            android:id="@+id/widget_wird"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_wird_name"
                    style="@style/WidgetText"
                    android:text="ختمة الورد"
                    android:textColor="#2E2A24"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_wird_check"
                    style="@style/WidgetText"
                    android:layout_marginStart="6dp"
                    android:text="✓"
                    android:textColor="#8A6110"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_wird_line"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:layout_marginTop="2dp"
                android:text="الورد ١٢ من ٣٠ · من ص ٢٢١ إلى ٢٤٠"
                android:textColor="#B82E2A24"
                android:textSize="13.5sp" />

            <FrameLayout
                android:id="@+id/widget_bar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/widget_bar_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_bar"
                    android:tint="#2E2E2A24" />

                <ImageView
                    android:id="@+id/widget_bar_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_bar_fill"
                    android:tint="#8A6110" />
            </FrameLayout>
        </LinearLayout>

        <!-- ختمة الحفظ -->
        <LinearLayout
            android:id="@+id/widget_hifz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layoutDirection="rtl"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_hifz_name"
                    style="@style/WidgetText"
                    android:text="ختمة الحفظ"
                    android:textColor="#2E2A24"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_hifz_check"
                    style="@style/WidgetText"
                    android:layout_marginStart="6dp"
                    android:text="✓"
                    android:textColor="#8A6110"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_hifz_inline"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:textSize="13.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_step1"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:layout_marginTop="2dp"
                android:text="✓  المراجعة البعيدة"
                android:textColor="#8A6110"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/widget_step2"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:text="○  المراجعة القريبة"
                android:textColor="#B82E2A24"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/widget_step3"
                style="@style/WidgetText"
                android:layout_width="match_parent"
                android:text="○  حفظ الورد"
                android:textColor="#B82E2A24"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- بلا ختمة، أو انتهت الأيام المرسلة -->
        <TextView
            android:id="@+id/widget_message"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:textColor="#B82E2A24"
            android:textSize="13.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_action"
            style="@style/WidgetText"
            android:layout_marginTop="4dp"
            android:textColor="#8A6110"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
