<?xml version="1.0" encoding="utf-8"?>
<!--
  ويدجت «آية اليوم» (widgets/AyahWidget.java، الجلسة ٣ ج ٢). الآية صورةٌ يرسمها AyahWidget بخط المصحف (ayah_text)،
  وفي معاينة قائمة الويدجتات صورة مثال (drawable-nodpi/widget_ayah_preview: الرعد ٢٨ بالمظهر الافتراضي).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#F5EDDC" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/ayah_title"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_marginBottom="4dp"
            android:text="@string/widget_ayah_label"
            android:textColor="#8A6110"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ayah_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_ayah_label"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ayah_preview" />

        <TextView
            android:id="@+id/ayah_ref"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="سورة الرعد · ٢٨"
            android:textAlignment="center"
            android:textColor="#B82E2A24"
            android:textSize="12.5sp" />
    </LinearLayout>
</FrameLayout>
