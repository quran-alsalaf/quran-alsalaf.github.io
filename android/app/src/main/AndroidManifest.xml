<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- خدمة التلاوة (audio/QuranAudioService.java): تستمر والشاشة مقفلة، بإشعار وأزرار في شاشة القفل -->
        <service
            android:name=".audio.QuranAudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- تحميل صوت القرّاء لكامل القرآن (audio/QuranDownloadService.java): يستمر والشاشة مقفلة والتطبيق مغلق، بإشعار تقدّم -->
        <service
            android:name=".audio.QuranDownloadService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- تذكير الختمة اليومي (reminders/): إظهار الإشعار في وقته (داخلي)، وإعادة الجدولة بعد إعادة تشغيل الجوال
             وتحديث التطبيق وتغيّر المنطقة الزمنية أو ساعة الجهاز (رسائل النظام وحده) -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".reminders.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- ويدجت «ختمتي اليوم» على الشاشة الرئيسية (widgets/KhatmaWidget.java): رسائل الويدجت من النظام، وتبدّله عند
             منتصف الليل (منبّه داخلي باسمه الصريح) -->
        <receiver
            android:name=".widgets.KhatmaWidget"
            android:exported="true"
            android:label="@string/widget_khatma_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_khatma_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- التلاوة في الخلفية: خدمة أمامية لتشغيل الصوت، وإبقاء المعالج والشبكة يقظين والشاشة مقفلة -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- تحميل صوت القرّاء في الخلفية: خدمة أمامية للتحميل، وإشعار تقدّمه (يُطلب إذنه عند أول تحميل)، ومعرفة رجوع الاتصال -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- تذكير الختمة اليومي: إعادة جدولته بعد إعادة تشغيل الجوال (وإذن الإشعارات أعلاه يُطلب عند تفعيله) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
